# ==========================================
# OJARA — ENVIRONMENT VARIABLES
# Copy to .env.local and fill in. Never commit .env.local.
# ==========================================

# --- Wix Headless: OAuth (browser-safe, public) ---
# Wix Dashboard → Headless → OAuth Apps → create client
NEXT_PUBLIC_WIX_CLIENT_ID=

# --- Wix Headless: Admin API key (SERVER ONLY — never exposed to the browser) ---
# Creates/approves orders, applies draft-order discounts, marks payments.
# Wix Dashboard → Settings → API Keys
WIX_API_KEY=
WIX_SITE_ID=
WIX_ACCOUNT_ID=

# --- Razorpay ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Email notifications (nodemailer over Gmail SMTP) ---
# GMAIL_APP_PASSWORD must be a Google *App Password* (requires 2FA enabled).
GMAIL_USER=
GMAIL_APP_PASSWORD=
SUPPORT_EMAIL=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ==========================================
# SEO / ANALYTICS / TRACKING
# ==========================================

# --- Google Tag Manager (client) ---
# Paste your container id. GA4 and the Meta Pixel can be configured INSIDE the GTM
# dashboard. NOTE: Clarity is installed directly via NEXT_PUBLIC_CLARITY_ID below
# (not GTM) — the site had two GTM containers and the Clarity tag was stranded in
# the one that isn't shipped, so it recorded nothing.
# GTM → Admin → Container → "GTM-XXXXXXX"
NEXT_PUBLIC_GTM_ID=

# --- Microsoft Clarity (client) ---
# Direct install (bypasses GTM). Clarity → Settings → Overview → the ~10-char
# project id (also the value in clarity.ms/tag/XXXXXXXXXX). Empty = disabled.
NEXT_PUBLIC_CLARITY_ID=

# --- Meta Pixel (browser) ---
# Overrides the id baked into MetaPixel.tsx. Set empty to disable the browser Pixel.
NEXT_PUBLIC_META_PIXEL_ID=

# --- Meta Conversions API (server-side; token is NEVER exposed to the browser) ---
# Meta Events Manager → Data Sources → your pixel → Settings.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
# Optional: shows events under Events Manager → Test Events while you verify.
META_TEST_EVENT_CODE=

# --- Search engine verification (server-rendered <meta> tags) ---
# Google Search Console → Settings → Ownership verification → HTML tag (content value).
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Verify → Meta tag (the msvalidate.01 content value).
BING_SITE_VERIFICATION=
